<div id="LC527" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">        &lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;lurch-atom-body&quot;&gt;&lt;table&gt;&lt;colgroup&gt;&lt;col&gt;&lt;col&gt;&lt;/colgroup&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot;&gt;&lt;b&gt;Imported dependency document&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Description:&lt;/td&gt;&lt;td&gt;&lt;tt&gt;none&lt;/tt&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Source:&lt;/td&gt;&lt;td&gt;&lt;tt&gt;math/Sequences-Rules.lurch&lt;/tt&gt; (web)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Auto-refresh:&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;</div>
