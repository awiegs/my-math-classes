teditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;W\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e and\u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not V\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003econtrapositive\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;W implies V \u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⇒\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;≡ \u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not V implies not W\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⇒\u003c/span\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eDeMorgan's Law\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not (W and V)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.69444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not W or not V\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eDeMorgan's Law\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not (W or V)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.68333em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not W and not V\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eAnything follows from a contradiction\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;From →←\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eFrom \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e→←\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003c/p\u003e","\u003cp\u003eConclude \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;W\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003chr\u003e\u003c/div\u003e","\u003c/div\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Logic-theorems-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003cdiv\u003e","\u003cdiv\u003e","\u003cdiv\u003e","\u003ch1\u003ePeano Axioms\u003c/h1\u003e","\u003cdiv\u003eThis is a library containing the Peano Axioms. They define a formal system for the Natural Numbers.\u0026nbsp; This library includes all of the rules, definitions, and axioms from the Logic Theorems library.\u003c/div\u003e","\u003chr\u003e","\u003ch3\u003eConstants\u003c/h3\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Declare 0, sigma, +, ⋅, ≤\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eDeclare \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, and \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≤\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e to be constants.\u003c/p\u003e","\u003ch3\u003ePeano Axioms\u003c/h3\u003e","\u003ch4\u003e\u003cstrong\u003eThe set ℕ\u003c/strong\u003e\u003c/h4\u003e","\u003cp\u003e\u0026nbsp; \u0026nbsp; (We don't need axioms N0 or N1.)\u003c/p\u003e","\u003cp\u003e\u0026nbsp; \u0026nbsp; \u003cstrong\u003eN0:\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expositorymath\u0026quot;\" data-metadata_latex=\"\u0026quot;0\u0026quot;\" data-metadata_given=\"false\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e is a natural number.\u003c/p\u003e","\u003cp\u003e\u0026nbsp; \u0026nbsp; \u003cstrong\u003eN1:\u003c/strong\u003e For all natural numbers\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expositorymath\u0026quot;\" data-metadata_latex=\"\u0026quot;n\u0026quot;\" data-metadata_given=\"false\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e, the successor of \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expositorymath\u0026quot;\" data-metadata_latex=\"\u0026quot;n\u0026quot;\" data-metadata_given=\"false\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e is a natural number.\u003c/p\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eN2 (successor is injective):\u0026nbsp; \u0026nbsp; \u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;If sigma(m)=sigma(n)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eIf \u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;then \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m=n\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eN3 (zero is first):\u0026nbsp; \u0026nbsp; \u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;0 neq sigma(n)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__rlap\"\u003e\u003cspan class=\"ML__inner\"\u003e\u003cspan class=\"ML__cmr\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eN4 (induction):\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;If 𝜆P(0)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eIf \u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.64444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; (\u003cem\u003ethe Base Case\u003c/em\u003e)\u003c/p\u003e","\u003cp\u003eand we have the subproof\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u003cem\u003e(the Inductive step)\u003c/em\u003e\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;premise\u0026quot;\" data-shell_title=\"\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Let k be such that 𝜆P(k)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eLet \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e be such that \u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.69444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;𝜆P(sigma(k))\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.25em; height: 1em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.69444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cp\u003ethen we can conclude\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;forall n.𝜆P(n)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e∀\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e\u003cstrong\u003eAddition\u003c/strong\u003e\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eA0:\u0026nbsp; \u0026nbsp; \u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;n+0=n\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eA1:\u0026nbsp; \u0026nbsp;\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m+sigma(n)=sigma(m+n)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.08333em; height: 0.66666em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e\u003cstrong\u003eMultiplication\u003c/strong\u003e\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eM0: \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;n*0=0\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eM1: \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m*sigma(n) = m+m*n\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e\u003cstrong\u003eOrder\u003c/strong\u003e\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eI: \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m leq n ≡ exists k.m+k=n\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≤\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∃\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003chr\u003e\u003c/div\u003e","\u003c/div\u003e","\u003c/div\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Peano-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003cdiv\u003e","\u003cdiv\u003e\u0026nbsp;\u003c/div\u003e","\u003c/div\u003e","\u003ch1\u003eNumber Theory\u003c/h1\u003e","\u003cp\u003eThis library contains some definitions from Number Theory.\u0026nbsp; It includes all of the rules in the Peano Axioms library.\u003c/p\u003e","\u003chr\u003e","\u003ch3\u003eConstants\u003c/h3\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Declare 1, 2, 3, 4, 5, is, |, prime, even, odd\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eDeclare \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e1\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e2\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e3\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e4\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e5\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, is, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∣\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, prime, even, and odd\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003ch3\u003eDefinitions\u003c/h3\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eBase ten digits\u003c/strong\u003e\u003cbr\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;1=sigma(0)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e1\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.64444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;2=sigma(1)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e2\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.64444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e1\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;3=sigma(2)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e3\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.64444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e2\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;4=sigma(3)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e4\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.64444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e3\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;5=sigma(5)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e5\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.64444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e5\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eDivides:\u0026nbsp; \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m|n\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∣\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;exists k.n=m*k\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e∃\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003ePrime: \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;n is prime\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is prime\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;≡\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;1\u003cn\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e1\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026amp;\u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not (exists k.(1\u003ck and k\u003cn) and k|n)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.25em; height: 1em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∃\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.0391em; height: 0.73354em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e1\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ek\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∣\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eEven:\u0026nbsp; \u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;If n is even \u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eIf \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is even\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e then \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;n=2*m for some m\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e2\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e for some \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e.\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eEven: \u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;If n=2*m\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eIf \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e2\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e then \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;n is even\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is even\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e.\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eOdd:\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;n is odd\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is odd\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not n is even\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is even\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003chr\u003e\u003c/div\u003e","\u003c/div\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Number-theory-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003ch1\u003eEquations\u003c/h1\u003e","\u003cp\u003eThe Equations Rule is a special built-in validation tool that Lurch provides for dealing with proofs involving lengthy transitive chains of equations, such as\u0026nbsp;\u003c/p\u003e","\u003cp\u003e\u0026nbsp;\u003c/p\u003e","\u003cp style=\"text-align: center;\"\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expositorymath\u0026quot;\" data-metadata_latex=\"\u0026quot;\\\\begin{align*} a \u0026amp;= b \\\\\\\\ \u0026amp;=c \\\\\\\\ \u0026amp;=d\u0026quot;\" data-metadata_given=\"false\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mtable\"\u003e\u003cspan class=\"col-align-r\"\u003e\u003cspan class=\"ML__vlist-t ML__vlist-t2\"\u003e\u003cspan class=\"ML__vlist-r\"\u003e\u003cspan class=\"ML__vlist\" style=\"height: 2.36em;\"\u003e\u003cspan style=\"top: -4.51em;\"\u003e\u003cspan style=\"height: 1.5em; display: inline-block;\"\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__vlist-s\"\u003e​\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"col-align-l\"\u003e\u003cspan class=\"ML__vlist-t ML__vlist-t2\"\u003e\u003cspan class=\"ML__vlist-r\"\u003e\u003cspan class=\"ML__vlist\" style=\"height: 2.36em;\"\u003e\u003cspan style=\"top: -4.51em;\"\u003e\u003cspan style=\"height: 1.5em; display: inline-block;\"\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"top: -3.01em;\"\u003e\u003cspan style=\"height: 1.5em; display: inline-block;\"\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"top: -1.51em;\"\u003e\u003cspan style=\"height: 1.2em; display: inline-block;\"\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ed\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__vlist-s\"\u003e​\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp style=\"text-align: left;\"\u003e\u0026nbsp;\u003c/p\u003e","\u003cp style=\"text-align: left;\"\u003e(entered as\u0026nbsp;\u003ccode\u003ea=b=c=d\u003c/code\u003e).\u0026nbsp; It automates the application of the substitution and reflexive rules of equality, its derived properties of symmetry and transitivity, and checks each pair in the chain for both direct equality, and equality via a single substitution.\u0026nbsp; This topic includes everything from the Number Theory topic.\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eEquations Rule:\u003c/strong\u003e \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;EquationsRule\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eEquationsRule\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003chr\u003e","\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Equations-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003ch1\u003eNumber Theory Theorems\u003c/h1\u003e","\u003cp\u003eOnce we have proven theorems it is convenient to add the most useful ones as new rules rather than reproving them from scratch each time we need to use one.\u0026nbsp; This library contains some of the most useful theorems about the natural numbers that can be proven using the Peano Axioms.\u0026nbsp; All of the rules from the Number Theory library are also available.\u003c/p\u003e","\u003chr\u003e","\u003ch3\u003eTheorems\u003c/h3\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTheorem (alternate definition of 𝜎):\u0026nbsp;\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;sigma(n)=n+1\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"lcGreek ML__mathit\" style=\"margin-right: 0.04em;\"\u003eσ\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e1\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTheorem (commutativity of addition):\u0026nbsp;\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m+n=n+m\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTheorem (associativity of addition):\u0026nbsp;\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;(m+n)+p = m+(n+p)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.08333em; height: 0.66666em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ep\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.7777700000000001em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ep\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTheorem (identity of multiplication):\u0026nbsp;\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;n*1 = n\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e1\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTheorem (commutativity of multiplication):\u0026nbsp;\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m*n = n*m\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTheorem(associativity of multiplication):\u0026nbsp;\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;(m*n)*p = m*(n*p)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.44445em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ep\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.63889em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ep\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTheorem (distributive property of \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expositorymath\u0026quot;\" data-metadata_latex=\"\u0026quot;\\\\cdot\u0026quot;\" data-metadata_given=\"false\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e over \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expositorymath\u0026quot;\" data-metadata_latex=\"\u0026quot;+\u0026quot;\" data-metadata_given=\"false\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e):\u003c/strong\u003e \u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;m*(n+p)=m*n+m*p\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.7777700000000001em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ep\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003en\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003em\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ep\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003chr\u003e","\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003c