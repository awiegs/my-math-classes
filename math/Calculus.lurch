<div id="LC78" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">            &lt;div id=&quot;document&quot;&gt;&lt;h1&gt;Propositional Logic&lt;/h1&gt;</div>
<div id="LC79" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;This is a basic library of the rules that define a natural deduction style formal system for Propositional Logic. Premises are denoted by &#39;From&#39; and conclusions by &#39;Conclude&#39;.&lt;/p&gt;</div>
<div id="LC80" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;hr&gt;</div>
<div id="LC81" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;h3&gt;&lt;strong&gt;Constants&lt;/strong&gt;&lt;/h3&gt;</div>
<div id="LC82" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;Declare ⇔, and, ⇒, or, ¬, contradiction&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;Declare &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⇔&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, and, &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⇒&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, or, &lt;/span&gt;&lt;span class=&quot;ML__ams&quot;&gt;¬&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, and &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;→←&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; to be constants.&lt;/p&gt;</div>
<div id="LC83" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;h3&gt;&lt;strong&gt;Definitions&lt;/strong&gt;&lt;/h3&gt;</div>
<div id="LC84" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC85" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;and+&lt;/strong&gt;&lt;/p&gt;</div>
<div id="LC86" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p style=&quot;text-align: left;&quot;&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;From W&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;From &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.14em;&quot;&gt;W&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;From V&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;From &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.23em;&quot;&gt;V&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;Conclude &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;W and V&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot; W\\text{ and } V&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.14em;&quot;&gt;W&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt; and &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.23em;&quot;&gt;V&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC87" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC88" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC89" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;and-&lt;/strong&gt;&lt;/p&gt;</div>
<div id="LC90" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;From W and V&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;From &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.14em;&quot;&gt;W&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt; and &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.23em;&quot;&gt;V&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;Conclude &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;W&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;W&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.14em;&quot;&gt;W&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;Conclude &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;V&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;V&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.23em;&quot;&gt;V&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
