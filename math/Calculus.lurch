<div id="LC465" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;Theorem (distributive property of &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expositorymath&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;\\cdot&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; over &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expositorymath&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;+&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;):&lt;/strong&gt; &amp;nbsp;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;m*(n+p)=m*n+m*p&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: -0.19444em; height: 0.7777700000000001em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;p&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;p&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
