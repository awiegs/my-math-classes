<div id="LC151" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;contradiction+&lt;/strong&gt;&lt;/p&gt;</div>
<div id="LC152" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;From W&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;From &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.14em;&quot;&gt;W&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;From not W&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;From &lt;/span&gt;&lt;span class=&quot;ML__ams&quot;&gt;¬&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.14em;&quot;&gt;W&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;Conclude &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;→←&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;\\rightarrow\\leftarrow&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;→←&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
