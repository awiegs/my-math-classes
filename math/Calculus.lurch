=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⇒\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cbr\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;From W\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eFrom \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cbr\u003eConclude \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;V\u0026quot;\" data-metadata_latex=\"\u0026quot;V\u0026quot;\" data-metadata_given=\"false\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.23em;\"\u003eV\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eiff+\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003eFrom the two subproofs:\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;premise\u0026quot;\" data-shell_title=\"\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Assume W\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan cla