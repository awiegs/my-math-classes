 class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eTranslation:\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;If x\u003cy\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eIf \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e then \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x+z\u003cy+z\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e+\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eProduct of positives:\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;if 0\u003cx, 0\u003cy\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eif \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e then \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;0\u003cx*y\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e0\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e\u0026lt;\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⋅\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003chr\u003e","\u003ch3\u003e\u0026nbsp;\u003c/h3\u003e","\u003c/div\u003e","\u003c/div\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Reals-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003ch1\u003eSet Theory\u003c/h1\u003e","\u003cp\u003eWe now define a formal system for elementary naive set theory.\u0026nbsp; This library includes all of the rules, definitions, and axioms from the\u003ccode\u003eReals\u003c/code\u003elibrary.\u003c/p\u003e","\u003ch3\u003eConstants\u003c/h3\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Declare in, subset, cap, cup, complement, setminus , powerset, set\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eDeclare \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⊆\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∩\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∪\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__msubsup\"\u003e\u003cspan class=\"ML__vlist-t\"\u003e\u003cspan class=\"ML__vlist-r\"\u003e\u003cspan class=\"ML__vlist\" style=\"height: 0.73em;\"\u003e\u003cspan style=\"top: -3.41em; margin-right: 0.05em;\"\u003e\u003cspan style=\"height: 0.28em; display: inline-block; font-size: 70%;\"\u003e\u003cspan class=\"ML__cmr\"\u003e∘\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∖\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__sans\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, and set\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e to be constants.\u003c/p\u003e","\u003ch3\u003eDefinitions\u003c/h3\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eEmpty set: \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x notin Set()\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∉\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e{\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cp\u003e\u003cstrong\u003eFinite set notation:\u003c/strong\u003e\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in set(a) equiv x=a\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e{\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in set(a,b) equiv x=a or x=b\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.8888799999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e{\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in set(a,b,c) equiv x=a or (x=b or x=c)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.8888799999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e{\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.69444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in set(a,b,c,d) equiv \\nx=a or (x=b or (x=c or x=d))\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.8888799999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e{\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ed\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.25em; height: 1em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.69444em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ed\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eSet builder: \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in { z : @P(z) } equiv @P(x)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.25em; height: 1em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e{\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e:\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eSubset-:\u0026nbsp;\u003c/strong\u003e\u003cbr\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Assume A subset B\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u