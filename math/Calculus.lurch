<div id="LC523" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;n+m choose m =multinomial(n,m)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mfrac&quot;&gt;&lt;span class=&quot;ML__delim-size3&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__vlist-t ML__vlist-t2&quot;&gt;&lt;span class=&quot;ML__vlist-r&quot;&gt;&lt;span class=&quot;ML__vlist&quot; style=&quot;height: 1.09em;&quot;&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -3.5em;&quot;&gt;&lt;span style=&quot;height: 0.67em; display: inline-block;&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -2.31em;&quot;&gt;&lt;span style=&quot;height: 0.44em; display: inline-block;&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__vlist-s&quot;&gt;​&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__delim-size3&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: -0.19444em; height: 0.625em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;,&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC524" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
