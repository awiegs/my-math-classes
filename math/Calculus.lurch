;\u0026lt;col\u0026gt;\u0026lt;col\u0026gt;\u0026lt;/colgroup\u0026gt;\u0026lt;tbody\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td colspan=\u0026quot;2\u0026quot;\u0026gt;\u0026lt;b\u0026gt;Imported dependency document\u0026lt;/b\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Description:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;none\u0026lt;/tt\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Source:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;math/Number-theory-Rules.lurch\u0026lt;/tt\u0026gt; (web)\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Auto-refresh:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;yes\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;/tbody\u0026gt;\u0026lt;/table\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","            \u0026lt;div id=\u0026quot;document\u0026quot;\u0026gt;\u0026lt;h1\u0026gt;Equations\u0026lt;/h1\u0026gt;","\u0026lt;p\u0026gt;The Equations Rule is a special built-in validation tool that Lurch provides for dealing with proofs involving lengthy transitive chains of equations, such as\u0026amp;nbsp;\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;","\u0026lt;p style=\u0026quot;text-align: center;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expositorymath\u0026amp;quot;\u0026quot; data-metadata_latex=\u0026quot;\u0026amp;quot;\\\\begin{align*} a \u0026amp;amp;= b \\\\\\\\ \u0026amp;amp;=c \\\\\\\\ \u0026amp;amp;=d\u0026amp;quot;\u0026quot; data-metadata_given=\u0026quot;false\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mtable\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;col-align-r\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-t ML__vlist-t2\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-r\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist\u0026quot; style=\u0026quot;height: 2.36em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;top: -4.51em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 1.5em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;a\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-s\u0026quot;\u0026gt;​\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;col-align-l\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-t ML__vlist-t2\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-r\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist\u0026quot; style=\u0026quot;height: 2.36em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;top: -4.51em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 1.5em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;b\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;top: -3.01em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 1.5em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;c\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span style=\u0026quot;top: -1.51em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 1.2em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;d\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-s\u0026quot;\u0026gt;​\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;p style=\u0026quot;text-align: left;\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;","\u0026lt;p style=\u0026quot;text-align: left;\u0026quot;\u0026gt;(entered as\u0026amp;nbsp;\u0026lt;code\u0026gt;a=b=c=d\u0026lt;/code\u0026gt;).\u0026amp;nbsp; It automates the application of the substitution and reflexive rules of equality, its derived properties of symmetry and transitivity, and checks each pair in the chain for both direct equality, and equality via a single substitution.\u0026amp;nbsp; This topic includes everything from the Number Theory topic.\u0026lt;/p\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Equations Rule:\u0026lt;/strong\u0026gt; \u0026amp;nbsp; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;EquationsRule\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;EquationsRule\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;hr\u0026gt;","\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\u0026lt;/div\u0026gt;","        \u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;div class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;table\u0026gt;\u0026lt;colgroup\u0026gt;\u0026lt;col\u0026gt;\u0026lt;col\u0026gt;\u0026lt;/colgroup\u0026gt;\u0026lt;tbody\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td colspan=\u0026quot;2\u0026quot;\u0026gt;\u0026lt;b\u0026gt;Imported dependency document\u0026lt;/b\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Description:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;none\u0026lt;/tt\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Source:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;math/Equations-Rules.lurch\u0026lt;/tt\u0026gt; (web)\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Auto-refresh:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;yes\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;/tbody\u0026gt;\u0026lt;/table\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","            \u0026lt;div id=\u0026quot;document\u0026quot;\u0026gt;\u0026lt;h1\u0026gt;Number Theory Theorems\u0026lt;/h1\u0026gt;","\u0026lt;p\u0026gt;Once we have proven theorems it is convenient to add the most useful ones as new rules rather than reproving them from scratch each time we need to use one.\u0026amp;nbsp; This library contains some of the most useful theorems about the natural numbers that can be proven using the Peano Axioms.\u0026amp;nbsp; All of the rules from the Number Theory library are also available.\u0026lt;/p\u0026gt;","\u0026lt;hr\u0026gt;","\u0026lt;h3\u0026gt;Theorems\u0026lt;/h3\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Theorem (alternate definition of 𝜎):\u0026amp;nbsp;\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;sigma(n)=n+1\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.43056em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Theorem (commutativity of addition):\u0026amp;nbsp;\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;m+n=n+m\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Theorem (associativity of addition):\u0026amp;nbsp;\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;(m+n)+p = m+(n+p)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.08333em; height: 0.66666em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;p\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.19444em; height: 0.7777700000000001em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;p\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Theorem (identity of multiplication):\u0026amp;nbsp;\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;n*1 = n\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;1\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Theorem (commutativity of multiplication):\u0026amp;nbsp;\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;m*n = n*m\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Theorem(associativity of multiplication):\u0026amp;nbsp;\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;(m*n)*p = m*(n*p)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.44445em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;p\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.19444em; height: 0.63889em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;p\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Theorem (distributive property of \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expositorymath\u0026amp;quot;\u0026quot; data-metadata_latex=\u0026quot;\u0026amp;quot;\\\\cdot\u0026amp;quot;\u0026quot; data-metadata_given=\u0026quot;false\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; over \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expositorymath\u0026amp;quot;\u0026quot; data-metadata_latex=\u0026quot;\u0026amp;quot;+\u0026amp;quot;\u0026quot; data-metadata_given=\u0026quot;false\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;):\u0026lt;/strong\u0026gt; \u0026amp;nbsp;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;m*(n+p)=m*n+m*p\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.19444em; height: 0.7777700000000001em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;p\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;p\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;hr\u0026gt;","\u0026lt;p\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;\u0026lt;/div\u0026gt;","        \u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;div class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;table\u0026gt;\u0026lt;colgroup\u0026gt;\u0026lt;col\u0026gt;\u0026lt;col\u0026gt;\u0026lt;/colgroup\u0026gt;\u0026lt;tbody\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td colspan=\u0026quot;2\u0026quot;\u0026gt;\u0026lt;b\u0026gt;Imported dependency document\u0026lt;/b\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Description:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;none\u0026lt;/tt\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Source:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;math/Number-theory-theorems-Rules.lurch\u0026lt;/tt\u0026gt; (web)\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Auto-refresh:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;yes\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;/tbody\u0026gt;\u0026lt;/table\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","            \u0026lt;div id=\u0026quot;document\u0026quot;\u0026gt;\u0026lt;h1\u0026gt;Sequences and Recursion\u0026lt;/h1\u0026gt;","\u0026lt;p\u0026gt;Once we have defined the natural numbers we can use them to define sequences, both finite and infinite. They can be defined explicitly or recursively.\u0026amp;nbsp; In this topic we define a few well known recursive sequences.\u0026amp;nbsp; All of the rules, definitions, and theorems in the Number Theory Theorems topic are also available here.\u0026lt;/p\u0026gt;","\u0026lt;hr\u0026gt;","\u0026lt;h3\u0026gt;Constants\u0026lt;/h3\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;Declare Sum, Fib, !, multinomial, choose, ^\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;Declare Sum, \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.14em;\u0026quot;\u0026gt;F\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, factorial, multinomial, choose,\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;\u0026amp;nbsp;\u0026amp;amp;\u0026amp;nbsp;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__msubsup\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-t\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-r\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist\u0026quot; style=\u0026quot;height: 0.81em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;top: -3.41em; margin-right: 0.05em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.39em; display: inline-block; font-size: 70%;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∧\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; to be constants.\u0026lt;/p\u0026gt;","\u0026lt;h3\u0026gt;Definitions\u0026lt;/h3\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Summation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;sum k to 0 of @P(k) = @P(0)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__op-group\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-t ML__vlist-t2\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-r\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist\u0026quot; style=\u0026quot;height: 1.81em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -1.84em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.49em; display: inline-block; font-size: 70%;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=0\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -3.05em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 1.61em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__op-symbol ML__large-op\u0026quot;\u0026gt;∑\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -4.3em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.46em; display: inline-block; font-size: 70%;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-s\u0026quot;\u0026gt;​\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.69444em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.64444em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;sum k to sigma(n) of @P(k) = @P(sigma(n))+sum k to n of @P(k)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__op-group\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-t ML__vlist-t2\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-r\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist\u0026quot; style=\u0026quot;height: 1.97em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -1.84em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.49em; display: inline-block; font-size: 70%;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=0\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -3.05em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 1.61em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__op-symbol ML__large-op\u0026quot;\u0026gt;∑\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -4.38em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.7em; display: inline-block; font-size: 70%;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.43056em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-s\u0026quot;\u0026gt;​\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.69444em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.25em; height: 1em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.43056em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__op-group\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-t ML__vlist-t2\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-r\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist\u0026quot; style=\u0026quot;height: 1.66em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -1.84em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.49em; display: inline-block; font-size: 70%;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=0\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -3.05em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 1.61em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__op-symbol ML__large-op\u0026quot;\u0026gt;∑\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -4.3em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.31em; display: inline-block; font-size: 70%;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-s\u0026quot;\u0026gt;​\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.69444em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Natural Number Exponentiation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rul