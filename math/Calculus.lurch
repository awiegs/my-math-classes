t;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⇒&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.11em;&quot;&gt;U&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;Conclude &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;U&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;U&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.11em;&quot;&gt;U&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;</div>
<div id="LC133" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
