<div id="LC176" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
