<div id="LC157" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">            &lt;div id=&quot;document&quot;&gt;&lt;h1&gt;Predicate Logic with Equality&lt;/h1&gt;</div>
<div id="LC158" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;This is a basic library of the rules that define a natural deduction style formal system for Predicate Logic with equality.&amp;nbsp; All of the rules from the Propositional Logic library are also available.&lt;/p&gt;</div>
<div id="LC159" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;hr&gt;</div>
<div id="LC160" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;</div>
<div id="LC161" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;h3&gt;Constants&lt;/h3&gt;</div>
<div id="LC162" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;Declare ∀, ∃, ∃!, =&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;Declare &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;∀&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;∃&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;∃!&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, and &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; to be constants.&lt;/div&gt;</div>
<div id="LC163" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;h3&gt;Quantifier Rules&lt;/h3&gt;</div>
<div id="LC164" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;</div>
<div id="LC165" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC166" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong style=&quot;font-family: -apple-system, BlinkMacSystemFont, &#39;Segoe UI&#39;, Roboto, Oxygen, Ubuntu, Cantarell, &#39;Open Sans&#39;, &#39;Helvetica Neue&#39;, sans-serif;&quot;&gt;forall+&lt;/strong&gt;&lt;/p&gt;</div>
<div id="LC167" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;From the subproof:&lt;/p&gt;</div>
<div id="LC168" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;premise&amp;quot;&quot; data-shell_title=&quot;&quot;&gt;</div>
<div id="LC169" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;Let z&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;Let &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.05em;&quot;&gt;z&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;(a variable declaration)&amp;nbsp;&lt;/p&gt;</div>
<div id="LC170" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;𝜆P(z)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.05em;&quot;&gt;z&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC171" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC172" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;Conclude &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;forall x.𝜆P(x)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;∀&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;x&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;x&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;</div>
<div id="LC173" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC174" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
