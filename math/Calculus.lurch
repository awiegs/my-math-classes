;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; to be constants.\u0026lt;/p\u0026gt;","\u0026lt;h3\u0026gt;Definitions\u0026lt;/h3\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Empty set: \u0026amp;nbsp;\u0026lt;/strong\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;x notin Set()\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∉\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;{\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;}\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Finite set notation:\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expre