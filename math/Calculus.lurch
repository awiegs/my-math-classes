<div id="LC226" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;Let y be such that 𝜆P(y)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;Let &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;y&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt; be such that &lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: -0.19444em; height: 0.625em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;y&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC227" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;y=t&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;y&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;t&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC228" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC229" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;Conclude&amp;nbsp;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;∃!x.𝜆P(x)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;∃!&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;x&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;x&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;</div>
