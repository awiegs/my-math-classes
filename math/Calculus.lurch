u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Prop-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003ch1\u003ePredicate Logic with Equality\u003c/h1\u003e","\u003cp\u003eThis is a basic library of the rules that define a natural deduction style formal system for Predicate Logic with equality.\u0026nbsp; All of the rules from the Propositional Logic library are also available.\u003c/p\u003e","\u003chr\u003e","\u003cdiv\u003e","\u003ch3\u003eConstants\u003c/h3\u003e","\u003cdiv\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Declare ∀, ∃, ∃!, =\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eDeclare \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∀\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∃\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∃!\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, and \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e to be constants.\u003c/div\u003e","\u003ch3\u003eQuantifier Rules\u003c/h3\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\"\u003eforall+\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003eFrom the subproof:\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;premise\u0026quot;\" data-shell_title=\"\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Let z\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eLet \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp;(a variable declaration)\u0026nbsp;\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;𝜆P(z)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cp\u003eConclude \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;forall x.𝜆P(x)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e∀\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eforall-\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;From forall x.𝜆P(x)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eFrom \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∀\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003eConclude\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;𝜆P(t)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.61508em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003et\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eexists+\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;From 𝜆P(t)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eFrom \u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.61508em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003et\u003c/span\u003e\u003cspan