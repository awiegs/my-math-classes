0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__center\u0026quot; style=\u0026quot;top: -2.31em;\u0026quot;\u0026gt;\u0026lt;span style=\u0026quot;height: 0.44em; display: inline-block;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__vlist-s\u0026quot;\u0026gt;​\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__delim-size3\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.19444em; height: 0.625em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;,\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;\u0026lt;hr\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","        \u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;div class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;table\u0026gt;\u0026lt;colgroup\u0026gt;\u0026lt;col\u0026gt;\u0026lt;col\u0026gt;\u0026lt;/colgroup\u0026gt;\u0026lt;tbody\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td colspan=\u0026quot;2\u0026quot;\u0026gt;\u0026lt;b\u0026gt;Imported dependency document\u0026lt;/b\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Description:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;none\u0026lt;/tt\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Source:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;math/Sequences-Rules.lurch\u0026lt;/tt\u0026gt; (web)\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Auto-refresh:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;yes\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;/tbody\u0026gt;\u0026lt;/table\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","            \u0026lt;div id=\u0026quot;document\u0026quot;\u0026gt;\u0026lt;div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;h1\u0026gt;Real Numbers\u0026amp;nbsp;\u0026lt;/h1\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;p\u0026gt;We can now define a formal system for the Real Numbers.\u0026amp;nbsp; This library includes all of the rules, definitions, and axioms from the Sequences library.\u0026lt;/p\u0026gt;","\u0026lt;h3\u0026gt;Constants\u0026lt;/h3\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;Declare \u0026lt;, -\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;Declare \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;\u0026amp;lt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt; and \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;−\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; (the negative sign) to be constants.\u0026lt;/p\u0026gt;","\u0026lt;h3\u0026gt;Axioms\u0026lt;/h3\u0026gt;","\u0026lt;p\u0026gt;We include here all of the rules of inference for the real numbers except for the completeness axiom, which is beyond the scope of this course.\u0026lt;/p\u0026gt;","\u0026lt;h4\u0026gt;\u0026lt;strong\u0026gt;Axioms of Addition\u0026lt;/strong\u0026gt;\u0026lt;/h4\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Additive identity\u0026lt;br\u0026gt;\u0026lt;/strong\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;x+0=x\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;br\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;0+x=x\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Additive inverse\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;x+(-x)=0\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026qu