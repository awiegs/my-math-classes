\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eA\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003cem\u003eand\u003c/em\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x notin B\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∉\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eComplement:\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in B complement equiv x notin B\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003cspan class=\"ML__msubsup\"\u003e\u003cspan class=\"ML__vlist-t\"\u003e\u003cspan class=\"ML__vlist-r\"\u003e\u003cspan class=\"ML__vlist\" style=\"height: 0.81em;\"\u003e\u003cspan style=\"top: -3.41em; margin-right: 0.05em;\"\u003e\u003cspan style=\"height: 0.39em; display: inline-block; font-size: 70%;\"\u003e\u003cspan class=\"ML__cmr\"\u003e′\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∉\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cp\u003e\u003cstrong\u003eOrdered tuple:\u003c/strong\u003e\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003e(pair):\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom atom-is-selected\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;⟨a,b⟩=⟨c,d⟩\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.8888799999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e⟨\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e⟩\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.8888799999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e⟨\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ed\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e⟩\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;a=c\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003cem\u003eand \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;b=d\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ed\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003e(triple):\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0