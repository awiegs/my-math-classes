=\"\u0026quot;a=d\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ed\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e,\u003cem\u003e\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;b=e\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ee\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e, and \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;c=f\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.11em;\"\u003ef\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/em\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cp\u003e\u003cstrong\u003eCartesian product\u003c/strong\u003e\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003e(pair):\u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;z in A cross B\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eA\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e×\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;z=⟨a,b⟩ and (a in A and b in B) for some a,b\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.8888799999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e⟨\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e⟩\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.0391em; height: 0.73354em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eA\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e for some \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003e(triple):\u0026nbsp; \u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;z in A cross B cross C\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eA\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e×\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e×\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.08em;\"\u003eC\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp style=\"text-align: center;\"\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;z=⟨a,b,c⟩ and (a in A and (b in B and c in C)) for some a,b,c\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.05em;\"\u003ez\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.8888799999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e⟨\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e⟩\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.25em; height: 1em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eA\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.0391em; height: 0.73354em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.08em;\"\u003eC\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e for some \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eb\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, and \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003chr\u003e\u003c/div\u003e","\u003c/div\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Sets-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv data-category=\"settings\" data-key=\"shell style\" data-value-type=\"json\"\u003e\"minimal\"\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003cdiv\u003e\u0026nbsp;\u003c/div\u003e","\u003cdiv\u003e","\u003ch1\u003eRelations\u003c/h1\u003e","\u003cp\u003eWe now define a formal system for defining elementary concepts for relations.\u0026nbsp; This library includes all of the rules, definitions, and axioms from the Functions library.\u003c/p\u003e","\u003c/div\u003e","\u003ch3\u003eConstants\u003c/h3\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Declare ~, reflexive, symmetric, transitive, irreflexive, antisymmetric\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eDeclare \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e, reflexive, symmetric, transitive, irreflexive, and antisymmetric\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e,\u0026nbsp;\u003cbr\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;declare total, class, partial order, strict partial order, total order\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003edeclare total, class, partial order, strict partial order, and total order\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e, and\u003cbr\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;declare equivalence relation, partition\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003edeclare equivalence relation and partition\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e to be constants.\u003c/p\u003e","\u003cp\u003eNote: you can use `~` as relation in infix notation e.g. by typing\u003ccode\u003ex~y\u003c/code\u003e or in prefix notation if you surround it with single quotes, e.g. \u003ccode\u003e'~'(x,y)\u003c/code\u003e means the same thing.\u0026nbsp; You can also refer to \u003ccode\u003e'~'\u003c/code\u003e as a set of ordered pairs by enclosing it in single quotes as illustrated by the first definition below.\u0026nbsp; You can talk about properties of the relation tilde by enclosing it with single quotes as well, e.g. \u003ccode\u003e'~' is reflexive.\u003c/code\u003e\u003c/p\u003e","\u003ch3\u003eDefinitions\u003c/h3\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eRelations as a set of pairs:\u003c/strong\u003e\u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x~y\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;equiv\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;⟨x,y⟩ in '~'\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.625em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e⟨\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e,\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e⟩\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈∼\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003c/p\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eReflexive:\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;if '~' is reflexive\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eif \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is reflexive\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e then \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x~x\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e.\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eReflexive:\u003c/strong\u003e From the subproof\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;subproof\u0026quot;\" data-shell_title=\"\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Let x\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eLet \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e be arbitrary\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x~x\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cp\u003ewe can conclude\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;'~' is reflexive\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is reflexive\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e.\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eSymmetric:\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;If '~' is symmetric, x~y\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eIf \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e is symmetric and \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e then \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;y~x\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∼\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data