<div id="LC480" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC481" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC482" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;sum k to sigma(n) of @P(k) = @P(sigma(n))+sum k to n of @P(k)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__op-group&quot;&gt;&lt;span class=&quot;ML__vlist-t ML__vlist-t2&quot;&gt;&lt;span class=&quot;ML__vlist-r&quot;&gt;&lt;span class=&quot;ML__vlist&quot; style=&quot;height: 1.97em;&quot;&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -1.84em;&quot;&gt;&lt;span style=&quot;height: 0.49em; display: inline-block; font-size: 70%;&quot;&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;k&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=0&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -3.05em;&quot;&gt;&lt;span style=&quot;height: 1.61em; display: inline-block;&quot;&gt;&lt;span class=&quot;ML__op-symbol ML__large-op&quot;&gt;∑&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -4.38em;&quot;&gt;&lt;span style=&quot;height: 0.7em; display: inline-block; font-size: 70%;&quot;&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__vlist-s&quot;&gt;​&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.69444em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;k&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: -0.25em; height: 1em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;ML__op-group&quot;&gt;&lt;span class=&quot;ML__vlist-t ML__vlist-t2&quot;&gt;&lt;span class=&quot;ML__vlist-r&quot;&gt;&lt;span class=&quot;ML__vlist&quot; style=&quot;height: 1.66em;&quot;&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -1.84em;&quot;&gt;&lt;span style=&quot;height: 0.49em; display: inline-block; font-size: 70%;&quot;&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;k&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=0&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -3.05em;&quot;&gt;&lt;span style=&quot;height: 1.61em; display: inline-block;&quot;&gt;&lt;span class=&quot;ML__op-symbol ML__large-op&quot;&gt;∑&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__center&quot; style=&quot;top: -4.3em;&quot;&gt;&lt;span style=&quot;height: 0.31em; display: inline-block; font-size: 70%;&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__vlist-s&quot;&gt;​&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.69444em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;k&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
