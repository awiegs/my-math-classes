;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;→←\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;Conclude \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;W\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.14em;\u0026quot;\u0026gt;W\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;hr\u0026gt;\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","        \u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;div class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;table\u0026gt;\u0026lt;colgroup\u0026gt;\u0026lt;col\u0026gt;\u0026lt;col\u0026gt;\u0026lt;/colgroup\u0026gt;\u0026lt;tbody\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td colspan=\u0026quot;2\u0026quot;\u0026gt;\u0026lt;b\u0026gt;Imported dependency document\u0026lt;/b\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Description:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;none\u0026lt;/tt\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Source:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;math/Logic-theorems-Rules.lurch\u0026lt;/tt\u0026gt; (web)\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Auto-refresh:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;yes\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;/tbody\u0026gt;\u0026lt;/table\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","            \u0026lt;div id=\u0026quot;document\u0026quot;\u0026gt;\u0026lt;div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;h1\u0026gt;Peano Axioms\u0026lt;/h1\u0026gt;","\u0026lt;div\u0026gt;This is a library containing the Peano Axioms. They define a formal system for the Natural Numbers.\u0026amp;nbsp; This library includes all of the rules, definitions, and axioms from the Logic Theorems library.\u0026lt;/div\u0026gt;","\u0026lt;hr\u0026gt;","\u0026lt;h3\u0026gt;Constants\u0026lt;/h3\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;Declare 0, sigma, +, ⋅, ≤\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;Declare \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;+\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;⋅\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, and \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;≤\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; to be constants.\u0026lt;/p\u0026gt;","\u0026lt;h3\u0026gt;Peano Axioms\u0026lt;/h3\u0026gt;","\u0026lt;h4\u0026gt;\u0026lt;strong\u0026gt;The set ℕ\u0026lt;/strong\u0026gt;\u0026lt;/h4\u0026gt;","\u0026lt;p\u0026gt;\u0026amp;nbsp; \u0026amp;nbsp; (We don\u0026#39;t need axioms N0 or N1.)\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;\u0026amp;nbsp; \u0026amp;nbsp; \u0026lt;strong\u0026gt;N0:\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expositorymath\u0026amp;quot;\u0026quot; data-metadata_latex=\u0026quot;\u0026amp;quot;0\u0026amp;quot;\u0026quot; data-metadata_given=\u0026quot;false\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; is a natural number.\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;\u0026amp;nbsp; \u0026amp;nbsp; \u0026lt;strong\u0026gt;N1:\u0026lt;/strong\u0026gt; For all natural numbers\u0026amp;nbsp;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expositorymath\u0026amp;quot;\u0026quot; data-metadata_latex=\u0026quot;\u0026amp;quot;n\u0026amp;quot;\u0026quot; data-metadata_given=\u0026quot;false\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;, the successor of \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expositorymath\u0026amp;quot;\u0026quot; data-metadata_latex=\u0026quot;\u0026amp;quot;n\u0026amp;quot;\u0026quot; data-metadata_given=\u0026quot;false\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; is a natural number.\u0026lt;/p\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;N2 (successor is injective):\u0026amp;nbsp; \u0026amp;nbsp; \u0026lt;/strong\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;If sigma(m)=sigma(n)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;If \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.43056em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.43056em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026amp;nbsp;then \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;m=n\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;m\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;N3 (zero is first):\u0026amp;nbsp; \u0026amp;nbsp; \u0026lt;/strong\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;0 neq sigma(n)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__rlap\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__inner\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.43056em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;N4 (induction):\u0026lt;/strong\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;If 𝜆P(0)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;If \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.64444em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;0\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; (\u0026lt;em\u0026gt;the Base Case\u0026lt;/em\u0026gt;)\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;and we have the subproof\u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026lt;em\u0026gt;(the Inductive step)\u0026lt;/em\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;premise\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;Let k be such that 𝜆P(k)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;Let \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt; be such that \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.69444em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;𝜆P(sigma(k))\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.25em; height: 1em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;lcGreek ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;σ\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.69444em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;k\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;p\u0026gt;then we can conclude\u0026amp;nbsp;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;forall n.𝜆P(n)\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∀\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;.\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cal\u0026quot; style=\u0026quot;margin-right: 0.09em;\u0026quot;\u0026gt;P\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: 0em; height: 0.43056em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;n\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;\u0026lt;strong\u0026gt;Addition\u0026lt;/strong\u0026gt;\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div clas