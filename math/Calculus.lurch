lass=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.05em;\u0026quot;\u0026gt;z\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∈\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;×\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.06em;\u0026quot;\u0026gt;B\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;×\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.08em;\u0026quot;\u0026gt;C\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026amp;nbsp; \u0026amp;nbsp; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;equiv\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;≡\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;p style=\u0026quot;text-align: center;\u0026quot;\u0026gt;\u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026amp;nbsp; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;z=⟨a,b,c⟩ and (a in A and (b in B and c in C)) for some a,b,c\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.05em;\u0026quot;\u0026gt;z\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;=\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.19444em; height: 0.8888799999999999em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;⟨\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;a\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;,\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;b\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;,\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;c\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;⟩\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt; and \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.25em; height: 1em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;a\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∈\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;A\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt; and \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.0391em; height: 0.73354em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;(\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;b\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∈\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.06em;\u0026quot;\u0026gt;B\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt; and \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;c\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∈\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.08em;\u0026quot;\u0026gt;C\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;)\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt; for some \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;a\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;b\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, and \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;c\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;hr\u0026gt;\u0026lt;/div\u0026gt;","\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","        \u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;div class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;table\u0026gt;\u0026lt;colgroup\u0026gt;\u0026lt;col\u0026gt;\u0026lt;col\u0026gt;\u0026lt;/colgroup\u0026gt;\u0026lt;tbody\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td colspan=\u0026quot;2\u0026quot;\u0026gt;\u0026lt;b\u0026gt;Imported dependency document\u0026lt;/b\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Description:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;none\u0026lt;/tt\u0026gt;\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Source:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;\u0026lt;tt\u0026gt;math/Sets-Rules.lurch\u0026lt;/tt\u0026gt; (web)\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;tr\u0026gt;\u0026lt;td\u0026gt;Auto-refresh:\u0026lt;/td\u0026gt;\u0026lt;td\u0026gt;yes\u0026lt;/td\u0026gt;\u0026lt;/tr\u0026gt;\u0026lt;/tbody\u0026gt;\u0026lt;/table\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;\u0026lt;div data-category=\u0026quot;settings\u0026quot; data-key=\u0026quot;shell style\u0026quot; data-value-type=\u0026quot;json\u0026quot;\u0026gt;\u0026quot;minimal\u0026quot;\u0026lt;/div\u0026gt;\u0026lt;/div\u0026gt;","            \u0026lt;div id=\u0026quot;document\u0026quot;\u0026gt;\u0026lt;div\u0026gt;\u0026amp;nbsp;\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;h1\u0026gt;Relations\u0026lt;/h1\u0026gt;","\u0026lt;p\u0026gt;We now define a formal system for defining elementary concepts for relations.\u0026amp;nbsp; This library includes all of the rules, definitions, and axioms from the Functions library.\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;h3\u0026gt;Constants\u0026lt;/h3\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;Declare ~, reflexive, symmetric, transitive, irreflexive, antisymmetric\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;Declare \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∼\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;, reflexive, symmetric, transitive, irreflexive, and antisymmetric\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;,\u0026amp;nbsp;\u0026lt;br\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;declare total, class, partial order, strict partial order, total order\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;declare total, class, partial order, strict partial order, and total order\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;, and\u0026lt;br\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;declare equivalence relation, partition\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;declare equivalence relation and partition\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; to be constants.\u0026lt;/p\u0026gt;","\u0026lt;p\u0026gt;Note: you can use `~` as relation in infix notation e.g. by typing\u0026lt;code\u0026gt;x~y\u0026lt;/code\u0026gt; or in prefix notation if you surround it with single quotes, e.g. \u0026lt;code\u0026gt;\u0026#39;~\u0026#39;(x,y)\u0026lt;/code\u0026gt; means the same thing.\u0026amp;nbsp; You can also refer to \u0026lt;code\u0026gt;\u0026#39;~\u0026#39;\u0026lt;/code\u0026gt; as a set of ordered pairs by enclosing it in single quotes as illustrated by the first definition below.\u0026amp;nbsp; You can talk about properties of the relation tilde by enclosing it with single quotes as well, e.g. \u0026lt;code\u0026gt;\u0026#39;~\u0026#39; is reflexive.\u0026lt;/code\u0026gt;\u0026lt;/p\u0026gt;","\u0026lt;h3\u0026gt;Definitions\u0026lt;/h3\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Relations as a set of pairs:\u0026lt;/strong\u0026gt;\u0026amp;nbsp; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;x~y\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∼\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;y\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; \u0026amp;nbsp; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;equiv\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;≡\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; \u0026amp;nbsp; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;⟨x,y⟩ in \u0026#39;~\u0026#39;\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__left-right\u0026quot; style=\u0026quot;margin-top: -0.19444em; height: 0.625em;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__open\u0026quot;\u0026gt;⟨\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;,\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot; style=\u0026quot;margin-right: 0.04em;\u0026quot;\u0026gt;y\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__small-delim ML__close\u0026quot;\u0026gt;⟩\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∈∼\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026amp;nbsp;\u0026lt;/p\u0026gt;","\u0026lt;/div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div\u0026gt;","\u0026lt;div class=\u0026quot;lurch-atom\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;rule\u0026amp;quot;\u0026quot; data-shell_title=\u0026quot;Rule:\u0026quot;\u0026gt;","\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;Reflexive:\u0026lt;/strong\u0026gt; \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;if \u0026#39;~\u0026#39; is reflexive\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt;if \u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∼\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__text\u0026quot;\u0026gt; is reflexive\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt; then \u0026lt;span class=\u0026quot;lurch-atom\u0026quot; contenteditable=\u0026quot;false\u0026quot; data-metadata_type=\u0026quot;\u0026amp;quot;expression\u0026amp;quot;\u0026quot; data-metadata_lurch-notation=\u0026quot;\u0026amp;quot;x~x\u0026amp;quot;\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;lurch-atom-body\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__latex\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__base\u0026quot;\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__cmr\u0026quot;\u0026gt;∼\u0026lt;/span\u0026gt;\u0026lt;span class=\u0026quot;ML__mathit\u0026quot;\u0026gt;x\u0026lt;/span\u0026gt;\u0026lt;/span\u0026gt;\u002