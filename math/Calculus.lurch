\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003eConclude \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;𝜆P(c) for some c\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e for some \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; \u0026nbsp; (constant declaration)\u003c/p\u003e","\u003c/div\u003e","\u003ch3\u003eEquality\u003c/h3\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003ereflexivity\u0026nbsp; \u0026nbsp;\u003c/strong\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;W=W\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan c