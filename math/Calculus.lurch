<div id="LC321" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;hr&gt;</div>
<div id="LC322" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;h3&gt;Constants&lt;/h3&gt;</div>
<div id="LC323" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;Declare 0, sigma, +, ⋅, ≤&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;Declare &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;0&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, &lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt;, and &lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;≤&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; to be constants.&lt;/p&gt;</div>
<div id="LC324" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;h3&gt;Peano Axioms&lt;/h3&gt;</div>
<div id="LC325" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;h4&gt;&lt;strong&gt;The set ℕ&lt;/strong&gt;&lt;/h4&gt;</div>
<div id="LC326" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&amp;nbsp; &amp;nbsp; (We don&#39;t need axioms N0 or N1.)&lt;/p&gt;</div>
<div id="LC327" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&amp;nbsp; &amp;nbsp; &lt;strong&gt;N0:&lt;/strong&gt; &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expositorymath&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;0&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;0&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; is a natural number.&lt;/p&gt;</div>
<div id="LC328" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&amp;nbsp; &amp;nbsp; &lt;strong&gt;N1:&lt;/strong&gt; For all natural numbers&amp;nbsp;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expositorymath&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;n&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;, the successor of &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expositorymath&amp;quot;&quot; data-metadata_latex=&quot;&amp;quot;n&amp;quot;&quot; data-metadata_given=&quot;false&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; is a natural number.&lt;/p&gt;</div>
<div id="LC329" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;</div>
<div id="LC330" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC331" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;N2 (successor is injective):&amp;nbsp; &amp;nbsp; &lt;/strong&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;If sigma(m)=sigma(n)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;If &lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&amp;nbsp;then &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;m=n&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC332" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC333" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC334" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;</div>
<div id="LC335" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC336" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;N3 (zero is first):&amp;nbsp; &amp;nbsp; &lt;/strong&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;0 neq sigma(n)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;0&lt;/span&gt;&lt;span class=&quot;ML__rlap&quot;&gt;&lt;span class=&quot;ML__inner&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC337" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC338" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC339" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;</div>
<div id="LC340" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC341" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;N4 (induction):&lt;/strong&gt;&lt;/p&gt;</div>
<div id="LC342" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;If 𝜆P(0)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;If &lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.64444em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;0&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (&lt;em&gt;the Base Case&lt;/em&gt;)&lt;/p&gt;</div>
<div id="LC343" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;and we have the subproof&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;em&gt;(the Inductive step)&lt;/em&gt;&lt;/p&gt;</div>
<div id="LC344" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;premise&amp;quot;&quot; data-shell_title=&quot;&quot;&gt;</div>
<div id="LC345" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;Let k be such that 𝜆P(k)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__text&quot;&gt;Let &lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;k&lt;/span&gt;&lt;span class=&quot;ML__text&quot;&gt; be such that &lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.69444em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;k&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC346" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;𝜆P(sigma(k))&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: -0.25em; height: 1em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.69444em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;k&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC347" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC348" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;then we can conclude&amp;nbsp;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;forall n.𝜆P(n)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__cmr&quot;&gt;∀&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;ML__cal&quot; style=&quot;margin-right: 0.09em;&quot;&gt;P&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC349" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC350" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC351" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;&lt;strong&gt;Addition&lt;/strong&gt;&lt;/div&gt;</div>
<div id="LC352" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;</div>
<div id="LC353" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC354" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;A0:&amp;nbsp; &amp;nbsp; &lt;/strong&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;n+0=n&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;0&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC355" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC356" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC357" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;A1:&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/strong&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;m+sigma(n)=sigma(m+n)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.43056em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;lcGreek ML__mathit&quot; style=&quot;margin-right: 0.04em;&quot;&gt;σ&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: -0.08333em; height: 0.66666em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;+&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC358" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC359" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC360" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;&lt;strong&gt;Multiplication&lt;/strong&gt;&lt;/div&gt;</div>
<div id="LC361" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div&gt;</div>
<div id="LC362" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;div class=&quot;lurch-atom&quot; data-metadata_type=&quot;&amp;quot;rule&amp;quot;&quot; data-shell_title=&quot;Rule:&quot;&gt;</div>
<div id="LC363" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;M0: &amp;nbsp;&lt;/strong&gt;&lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;n*0=0&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;0&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;0&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
<div id="LC364" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
<div id="LC365" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;/div&gt;</div>
