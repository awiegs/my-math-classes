e\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003eConclude\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;𝜆P(v)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ev\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003ch3\u003eUnique Existence\u003c/h3\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eunique existence-\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;From ∃!x.𝜆P(x)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eFrom \u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∃!\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003eConclude \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;𝜆P(c) and (forall y.(𝜆P(y) implies y=c)) for some c\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e and \u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.25em; height: 1em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∀\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.25em; height: 1em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.625em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e⇒\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e for some \u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ec\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eunique existence+\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;From 𝜆P(t)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eFrom \u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.61508em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003et\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003eFrom the subproof:\u0026nbsp;\u003c/p\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;premise\u0026quot;\" data-shell_title=\"\"\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;Let y be such that 𝜆P(y)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__text\"\u003eLet \u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e be such that \u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.19444em; height: 0.625em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;y=t\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.04em;\"\u003ey\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e=\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003et\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cp\u003eConclude\u0026nbsp;\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;∃!x.𝜆P(x)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__cmr\"\u003e∃!\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e.\u003c/span\u003e\u003cspan class=\"ML__cal\" style=\"margin-right: 0.09em;\"\u003eP\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: 0em; height: 0.43056em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u0026nbsp;\u003c/p\u003e","\u003c/div\u003e","\u003chr\u003e\u003c/div\u003e","\u003c/div\u003e\u003c/div\u003e","        \u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"lurch-atom-body\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd colspan=\"2\"\u003e\u003cb\u003eImported dependency document\u003c/b\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eDescription:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003enone\u003c/tt\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eSource:\u003c/td\u003e\u003ctd\u003e\u003ctt\u003emath/Pred-Rules.lurch\u003c/tt\u003e (web)\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eAuto-refresh:\u003c/td\u003e\u003ctd\u003eyes\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","            \u003cdiv id=\"document\"\u003e\u003cdiv\u003e","\u003cdiv\u003e\u0026nbsp;\u003c/div\u003e","\u003c/div\u003e","\u003ch1\u003eLogic Theorems\u003c/h1\u003e","\u003cp\u003eThis is a basic library of the rules that are theorems provable in the system defined by the rules in the Predicate Logic with Equality library.\u003c/p\u003e","\u003chr\u003e","\u003ch3\u003eConstants\u003c/h3\u003e","\u003cp\u003eNo additional constants are required.\u003c/p\u003e","\u003ch3\u003eTheorems (as rules)\u003c/h3\u003e","\u003cdiv\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eexcluded middle\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;W or not W\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__text\"\u003e or \u003c/span\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003edouble negative\u003c/strong\u003e\u003c/p\u003e","\u003cp\u003e\u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;not (not W)\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__left-right\" style=\"margin-top: -0.2em; height: 0.8999999999999999em;\"\u003e\u003cspan class=\"ML__small-delim ML__open\"\u003e(\u003c/span\u003e\u003cspan class=\"ML__ams\"\u003e¬\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.14em;\"\u003eW\u003c/span\u003e\u003cspan class=\"ML__small-delim ML__close\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u0026nbsp; \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=