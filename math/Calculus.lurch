<div id="LC460" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div ">&lt;p&gt;&lt;strong&gt;Theorem(associativity of multiplication):&amp;nbsp;&lt;/strong&gt; &lt;span class=&quot;lurch-atom&quot; contenteditable=&quot;false&quot; data-metadata_type=&quot;&amp;quot;expression&amp;quot;&quot; data-metadata_lurch-notation=&quot;&amp;quot;(m*n)*p = m*(n*p)&amp;quot;&quot;&gt;&lt;span class=&quot;lurch-atom-body&quot;&gt;&lt;span class=&quot;ML__latex&quot;&gt;&lt;span class=&quot;ML__base&quot;&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: 0em; height: 0.44445em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;p&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;m&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__left-right&quot; style=&quot;margin-top: -0.19444em; height: 0.63889em;&quot;&gt;&lt;span class=&quot;ML__small-delim ML__open&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;n&lt;/span&gt;&lt;span class=&quot;ML__cmr&quot;&gt;⋅&lt;/span&gt;&lt;span class=&quot;ML__mathit&quot;&gt;p&lt;/span&gt;&lt;span class=&quot;ML__small-delim ML__close&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</div>
