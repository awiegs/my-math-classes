a-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in A\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eA\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e \u003cem\u003eand\u003c/em\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;x in B\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ex\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e","\u003c/div\u003e","\u003c/div\u003e","\u003cdiv\u003e","\u003cdiv class=\"lurch-atom\" data-metadata_type=\"\u0026quot;rule\u0026quot;\" data-shell_title=\"Rule:\"\u003e","\u003cp\u003e\u003cstrong\u003eUnion:\u003c/strong\u003e \u003cspan class=\"lurch-atom\" contenteditable=\"false\" data-metadata_type=\"\u0026quot;expression\u0026quot;\" data-metadata_lurch-notation=\"\u0026quot;a in A union B equiv x in A or x in B\u0026quot;\"\u003e\u003cspan class=\"lurch-atom-body\"\u003e\u003cspan class=\"ML__latex\"\u003e\u003cspan class=\"ML__base\"\u003e\u003cspan class=\"ML__mathit\"\u003ea\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∈\u003c/span\u003e\u003cspan class=\"ML__mathit\"\u003eA\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e∪\u003c/span\u003e\u003cspan class=\"ML__mathit\" style=\"margin-right: 0.06em;\"\u003eB\u003c/span\u003e\u003cspan class=\"ML__cmr\"\u003e≡\u003c/span\u003e\u003cspan class=\"ML__