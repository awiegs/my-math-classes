</div>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;lim(x,a,f/g)=lim(x,a,f)/lim(x,a,g)&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">lim</span><span class="ML__left-right" style="margin-top: -0.8804400000000001em; height: 2.15932em;"><span class="ML__open ML__delim-size3">(</span><span class="ML__mathit">x</span><span class="ML__cmr">,</span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mfrac"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 1.28em;"><span class="ML__center" style="top: -2.31em;"><span style="height: 0.63em; display: inline-block;"><span class="ML__mathit" style="margin-right: 0.04em;">g</span></span></span><span class="ML__center" style="top: -3.58em;"><span style="height: 0.89em; display: inline-block;"><span class="ML__mathit" style="margin-right: 0.11em;">f</span></span></span></span><span class="ML__vlist-s">​</span></span></span></span><span class="ML__close ML__delim-size3">)</span></span><span class="ML__cmr">=</span><span class="ML__mfrac"><span class="ML__vlist-t ML__vlist-t2"><span class="ML__vlist-r"><span class="ML__vlist" style="height: 1.39em;"><span class="ML__center" style="top: -2.31em;"><span style="height: 1em; display: inline-block;"><span class="ML__text">lim</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.625em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit">x</span><span class="ML__cmr">,</span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mathit" style="margin-right: 0.04em;">g</span><span class="ML__small-delim ML__close">)</span></span></span></span><span class="ML__center" style="top: -3.64em;"><span style="height: 1em; display: inline-block;"><span class="ML__text">lim</span><span class="ML__left-right" style