<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;x neq a&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__mathit">x</span><span class="ML__rlap"><span class="ML__inner"><span class="ML__cmr"></span></span></span><span class="ML__cmr">=</span><span class="ML__mathit">a</span></span></span></span></span></p>
</div>
<p><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;limitExists(f,a) and limitExists(g,a) implies lim(x,a,f)=lim(x,a,g)&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">limitExists</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8888799999999999em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit" style="margin-right: 0.11em;">f</span><span class="ML__cmr">,</span><span class="ML__mathit">a</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__text"> and limitExists</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.625em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit" style="margin-right: 0.04em;">g</span><span class="ML__cmr">,</span><span class="ML__mathit">a</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">&rArr;</span><span class="ML__text">lim</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8888799999999999em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit">x</span><span class="ML__cmr">,</span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mathit" style="margin-right: 0.11em;">f</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">=</span><span class="ML__text">lim</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.625em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit">x</span><span class="ML__cmr">,</span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mathit" style="margin-right: 0.04em;">g</span><span class="ML__small-delim ML__close">)</span></span></span></span></span></span></p>
<p>&nbsp;</p>
</div>
<div class="lurch-atom unindented" data-metadata_type="&quot;rule&quot;" data-shell_title="Rule:">
<p><strong>Definition of a Limit</strong><span class="lurch-atom" contenteditable="false" data-metadata_type="&quot;expression&quot;" data-metadata_lurch-notation="&quot;limit(x,a,f)=L iff for all epsilon.(0&lt;epsilon implies exists delta.(0&lt;delta and for all x.((0&lt;abs(x-a) and abs(x-a)&lt;delta) implies abs(f-L)&lt;epsilon)))&quot;"><span class="lurch-atom-body"><span class="ML__latex"><span class="ML__base"><span class="ML__text">limit</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8888799999999999em;"><span class="ML__small-delim ML__open">(</span><span class="ML__mathit">x</span><span class="ML__cmr">,</span><span class="ML__mathit">a</span><span class="ML__cmr">,</span><span class="ML__mathit" style="margin-right: 0.11em;">f</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">=</span><span class="ML__mathit">L</span><span class="ML__cmr">&hArr;</span><span class="ML__cmr">&forall;ϵ.</span><span class="ML__left-right" style="margin-top: -0.25em; height: 1em;"><span class="ML__small-delim ML__open">(</span><span class="ML__cmr">0</span><span class="ML__cmr">&lt;</span><span class="ML__cmr">ϵ</span><span class="ML__cmr">&rArr;</span><span class="ML__cmr">&exist;</span><span class="lcGreek ML__mathit" style="margin-right: 0.04em;">&delta;</span><span class="ML__cmr">.</span><span class="ML__left-right" style="margin-top: -0.25em; height: 1em;"><span class="ML__small-delim ML__open">(</span><span class="ML__cmr">0</span><span class="ML__cmr">&lt;</span><span class="lcGreek ML__mathit" style="margin-right: 0.04em;">&delta;</span><span class="ML__text"> and </span><span class="ML__cmr">&forall;</span><span class="ML__mathit">x</span><span class="ML__cmr">.</span><span class="ML__left-right" style="margin-top: -0.25em; height: 1em;"><span class="ML__small-delim ML__open">(</span><span class="ML__left-right" style="margin-top: -0.25em; height: 1em;"><span class="ML__small-delim ML__open">(</span><span class="ML__cmr">0</span><span class="ML__cmr">&lt;</span><span class="ML__left-right" style="margin-top: -0.08333em; height: 0.66666em;"><span class="ML__small-delim ML__open">∣</span><span class="ML__mathit">x</span><span class="ML__cmr">&minus;</span><span class="ML__mathit">a</span><span class="ML__small-delim ML__close">∣</span></span><span class="ML__text"> and </span><span class="ML__left-right" style="margin-top: -0.08333em; height: 0.66666em;"><span class="ML__small-delim ML__open">∣</span><span class="ML__mathit">x</span><span class="ML__cmr">&minus;</span><span class="ML__mathit">a</span><span class="ML__small-delim ML__close">∣</span></span><span class="ML__cmr">&lt;</span><span class="lcGreek ML__mathit" style="margin-right: 0.04em;">&delta;</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__cmr">&rArr;</span><span class="ML__left-right" style="margin-top: -0.19444em; height: 0.8888799999999999em;"><span class="ML__small-delim ML__open">∣</span><span class="ML__mathit" style="margin-right: 0.11em;">f</span><span class="ML__cmr">&minus;</span><span class="ML__mathit">L</span><span class="ML__small-delim ML__close">∣</span></span><span class="ML__cmr">&lt;</span><span class="ML__cmr">ϵ</span><span class="ML__small-delim ML__close">)</span></span><span class="ML__small-delim ML__close">)</span></span><span class="ML__small-delim ML__close">)</span></span></span></span></span></span></p>
</div></div>
        